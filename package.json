{
  "name": "starry-flow",
  "productName": "Starry Flow",
  "version": "2.19.0",
  "description": "Starry Flow 星流 · 专注目标与进度可视化",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "build:monitor": "node scripts/build-monitor.mjs",
    "pack": "npm run build && npm run build:monitor && electron-builder --dir",
    "dist": "npm run build && npm run build:monitor && electron-builder"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.19",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.starryflow.app",
    "productName": "Starry Flow",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "monitor/dist/monitor.exe",
        "to": "monitor/monitor.exe"
      },
      {
        "from": "monitor/monitor.py",
        "to": "monitor/monitor.py"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Starry Flow"
    },
    "portable": {
      "artifactName": "StarryFlow-Portable.exe"
    }
  }
}
